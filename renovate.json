{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "semanticCommits": "enabled",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on the first day of the month"] },
  "packageRules": [
    {
      "description": "Group the non-breaking Cargo updates in one PR",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo non-major"
    },
    {
      "description": "Hashing backends: one PR each, they decide the performance and the build requirements",
      "matchPackageNames": ["aws-lc-rs", "aws-lc-sys", "sha1", "sha2"],
      "groupName": null
    },
    {
      "description": "Group the GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
